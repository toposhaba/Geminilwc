{
  "name": "chrome-gemini-nano-lwc",
  "private": true,
  "version": "1.0.0",
  "description": "Lightning Web Component that runs Chrome's built-in Gemini Nano model on-device via the Prompt API.",
  "scripts": {
    "lint": "eslint **/{aura,lwc}/**/*.js",
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "prettier": "prettier --write \"**/*.{css,html,js,json,md,yaml,yml}\"",
    "prettier:verify": "prettier --check \"**/*.{css,html,js,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^1.9.0",
    "@salesforce/eslint-config-lwc": "^3.5.3",
    "@salesforce/eslint-plugin-lightning": "^1.0.1",
    "@salesforce/sfdx-lwc-jest": "^5.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.9.0",
    "prettier": "^3.3.3",
    "prettier-plugin-apex": "^2.1.5"
  }
}
